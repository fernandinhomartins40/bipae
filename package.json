{
  "name": "bipae",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@bipae/api --filter=@bipae/web",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @bipae/web test:e2e",
    "format": "prettier --write .",
    "db:seed": "pnpm --filter @bipae/api db:seed",
    "tarefas": "node scripts/tarefas.mjs",
    "goal": "node scripts/goal.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module"
}
