# API (apps/api). Sem DATABASE_URL, a API usa PostgreSQL embutido (PGlite) em ./.data,
# então não precisa de Docker para desenvolver.
# DATABASE_URL=postgres://bipae:bipae@localhost:5432/bipae
PORT=3333
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://tauri.localhost,tauri://localhost

# Versão mínima por tipo de cliente (opcional). Abaixo dela a API pede atualização (HTTP 426),
# mas nunca recusa o envio de vendas pendentes.
# MIN_CLIENT_VERSION_DESKTOP=0.1.0
# MIN_CLIENT_VERSION_WEB=0.1.0

# Web e desktop
VITE_API_URL=http://localhost:3333
